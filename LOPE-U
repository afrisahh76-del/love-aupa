<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Love U Sayang ❤️</title>

<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{
    overflow:hidden;
    background:radial-gradient(circle,#ffb6d9,#ff4f8b,#7a003f);
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    font-family:'Segoe UI',sans-serif;
}

/* Bintang */
.star{
    position:absolute;
    width:2px;
    height:2px;
    background:white;
    border-radius:50%;
    animation:blink 2s infinite alternate;
}

@keyframes blink{
    from{opacity:.2;}
    to{
        opacity:1;
        transform:scale(2);
    }
}

/* Love besar */
#heart{
    position:absolute;
    left:50%;
    top:45%;
    transform:translate(-50%,-50%) scale(0);
    font-size:180px;
    filter:drop-shadow(0 0 35px #ff004c);
    animation:heartAppear 2s forwards 3s,
              heartBeat 1s infinite 5s;
}

@keyframes heartAppear{
    0%{
        transform:translate(-50%,-50%) scale(0) rotate(-180deg);
        opacity:0;
    }
    80%{
        transform:translate(-50%,-50%) scale(1.3);
        opacity:1;
    }
    100%{
        transform:translate(-50%,-50%) scale(1);
    }
}

@keyframes heartBeat{
    0%,100%{
        transform:translate(-50%,-50%) scale(1);
    }
    50%{
        transform:translate(-50%,-50%) scale(1.18);
    }
}

/* Teks */
#text{
    position:absolute;
    top:72%;
    width:100%;
    text-align:center;
    color:white;
    font-size:60px;
    font-weight:bold;
    letter-spacing:4px;
    opacity:0;
    text-shadow:0 0 20px #ff2d75;
    animation:showText 2s forwards 5s;
}

@keyframes showText{
    from{
        opacity:0;
        transform:translateY(40px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

/* Partikel */
.particle{
    position:absolute;
    font-size:28px;
    color:#ff3366;
}
</style>
</head>
<body>

<div id="heart">❤️</div>
<div id="text">LOVE U SAYANG ❤️</div>

<script>
// Bintang berkilau
for(let i=0;i<180;i++){
    let s=document.createElement("div");
    s.className="star";
    s.style.left=Math.random()*100+"vw";
    s.style.top=Math.random()*100+"vh";
    s.style.animationDelay=Math.random()*2+"s";
    document.body.appendChild(s);
}

// Love kecil berkumpul menjadi satu love besar
const total=220;
const cx=window.innerWidth/2;
const cy=window.innerHeight*0.45;

for(let i=0;i<total;i++){
    let h=document.createElement("div");
    h.className="particle";
    h.innerHTML="❤";

    h.style.left=Math.random()*window.innerWidth+"px";
    h.style.top=Math.random()*window.innerHeight+"px";

    document.body.appendChild(h);

    setTimeout(()=>{
        h.style.transition="all 3s ease-in-out";
        h.style.left=cx+"px";
        h.style.top=cy+"px";
        h.style.transform="translate(-50%,-50%) scale(0)";
        h.style.opacity="0";
    },500);
}

// Love beterbangan terus-menerus
setInterval(()=>{
    let h=document.createElement("div");
    h.innerHTML="💖";
    h.style.position="absolute";
    h.style.left=Math.random()*100+"vw";
    h.style.top="100vh";
    h.style.fontSize=(18+Math.random()*30)+"px";
    h.style.transition="transform 7s linear, opacity 7s linear";
    document.body.appendChild(h);

    setTimeout(()=>{
        h.style.transform="translateY(-120vh)";
        h.style.opacity="0";
    },50);

    setTimeout(()=>h.remove(),7000);
},180);
</script>

</body>
</html>
